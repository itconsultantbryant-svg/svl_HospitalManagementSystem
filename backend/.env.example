# Database: sqlite | postgres
# When DATABASE_URL is set (Neon / Render), Postgres is used automatically unless DB_TYPE=sqlite.
DB_TYPE=sqlite

# SQLite (when DB_TYPE=sqlite)
SQLITE_PATH=./data/hospital.db

# PostgreSQL — Neon injects DATABASE_URL into Functions automatically.
# Locally: run `neon env pull --file .env.neon.local` from repo root, or paste from console.
DATABASE_URL=

# Or build URL from discrete vars:
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hospital
PG_USER=postgres
PG_PASSWORD=

# Server (local / Render). Neon Functions ignore PORT.
PORT=3000

# Production
# CORS_ORIGIN=https://your-app.vercel.app
# JWT_SECRET=<generate a random 32+ char string>
